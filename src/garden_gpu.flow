# One typed Flow graphics pipeline, emitted as both WGSL and Metal.
# Used by the WebGPU browser frontend and the optional native Metal renderer.
# Does not simulate a second ecosystem. All geometry is built from the actual
# Flow garden state and its existing view-projection matrix.
import "stdlib/gpu_render.flow"

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
}

function main() -> i32 {
    let job: ptr<GpuJob> = gpu_job_new("garden_scene", 512, 480, "dist/gpu")
    let color: GpuTextureDesc = GpuTextureDesc {
        dimension: GPU_TEX_2D, format: GPU_FORMAT_RGBA8,
        width: 512, height: 480, layers: 1, samples: 1,
        usage: GPU_USE_COLOR_ATTACHMENT
    }
    let depth: GpuTextureDesc = GpuTextureDesc {
        dimension: GPU_TEX_2D, format: GPU_FORMAT_DEPTH32F,
        width: 512, height: 480, layers: 1, samples: 1,
        usage: GPU_USE_DEPTH_ATTACHMENT
    }
    let targets: GpuRenderTargets = GpuRenderTargets {
        color: color, depth: depth, has_depth: true
    }
    let varying: GpuVarying = GpuVarying {
        location: 0, scalar: GPU_SCALAR_F32, components: 3,
        interpolation: GPU_INTERPOLATE_PERSPECTIVE
    }
    let varyings: array<GpuVarying, 1> = [varying]
    let p: ptr<GpuPipeline> = gpu_pipeline_new(job, "garden", &varyings[0], 1, &varyings[0], 1)
    gpu_pipeline_targets(p, targets)
    gpu_pipeline_state(p, GPU_TOPOLOGY_TRIANGLES, GPU_CULL_NONE,
                       GPU_DEPTH_WRITE, GPU_BLEND_NONE)
    gpu_pipeline_vertex_buffer(p, 0, 24, GPU_STEP_VERTEX)
    let position: GpuVertexAttribute = GpuVertexAttribute {
        location: 0, offset: 0, stride: 24, scalar_bytes: 4, components: 3
    }
    let colour: GpuVertexAttribute = GpuVertexAttribute {
        location: 1, offset: 12, stride: 24, scalar_bytes: 4, components: 3
    }
    gpu_pipeline_attribute(p, 0, position)
    gpu_pipeline_attribute(p, 0, colour)
    gpu_pipeline_uniforms(p, 4)

    let vs: ptr<GxFn> = gpu_pipeline_vs(p)
    gx_out_position(vs, gx_mul(gx_umat(vs, 0),
                    gx_vec4_of(gx_attr(vs, 0), gx_f(1.0))))
    gx_out(vs, 0, gx_attr(vs, 1))
    let fs: ptr<GxFn> = gpu_pipeline_fs(p)
    gx_out_color(fs, gx_vec4_of(gx_in(fs, 0), gx_f(1.0)))
    if gpu_pipeline_finish(p) < 0 { return 1 }

    # One valid triangle suffices to write a complete typed GPU job.
    # The runtime backends replace it with the live garden vertex buffer.
    let vertex: ptr<f32> = calloc(18, 4) as ptr<f32>
    vertex[0] = -0.5
    vertex[1] = -0.5
    vertex[3] = 0.2
    vertex[4] = 0.8
    vertex[5] = 0.3
    vertex[6] = 0.5
    vertex[7] = -0.5
    vertex[9] = 0.3
    vertex[10] = 0.7
    vertex[11] = 0.2
    vertex[12] = 0.0
    vertex[13] = 0.5
    vertex[15] = 0.8
    vertex[16] = 0.3
    vertex[17] = 0.5
    let vb: i32 = gpu_vertex_buffer(job, vertex, 18)
    let uniform: ptr<f32> = calloc(16, 4) as ptr<f32>
    uniform[0] = 1.0
    uniform[5] = 1.0
    uniform[10] = 1.0
    uniform[15] = 1.0
    let ub: i32 = gpu_uniform_buffer(job, uniform, 4)
    let group: i32 = gpu_group(job, p, ub)
    let target: i32 = gpu_texture(job, color, null)
    let depth_target: i32 = gpu_texture(job, depth, null)
    gpu_pass(job, target, -1, depth_target, 0.28, 0.45, 0.58, 1.0)
    let vbs: array<i32, 1> = [vb]
    gpu_draw(job, p, group, &vbs[0], 1, 3, 1, 0, 0)
    gpu_output(job, target)
    if !gpu_job_write(job) { return 2 }
    println("PASS: Flow generated WGSL and Metal from one typed garden scene shader")
    return 0
}
